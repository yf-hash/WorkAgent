# WorkAgent .gitignore
#
# 运行时目录：hook 生成，不入 Git
.claude/audit/
.claude/backups/

# 流水线产出目录：三条端到端流水线（PM / SA / Content）生成到这里
# 保留一份 README/CHANGELOG 便于回溯的用法，改为白名单单独 add
output/

# 备份 / 临时文件
*.bak
*.tmp
*.swp
*~

# 系统 / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# Python 缓存
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Node
node_modules/
npm-debug.log
yarn-error.log

# 用户本地覆盖（不入库）
.claude/settings.local.json

# 原有条目（历史遗留，图像生成产物）
general_poster*.py
general_poster*.png
